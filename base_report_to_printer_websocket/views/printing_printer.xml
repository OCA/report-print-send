<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="printing_printer_view_form_inherit_websocket">
        <field
            name="name"
        >printing.printer.form (in base_report_to_printer_websocket)</field>
        <field
            name="inherit_id"
            ref="base_report_to_printer.printing_printer_view_form"
        />
        <field name="model">printing.printer</field>
        <field name="arch" type="xml">
            <group name="name" position="inside">
                <field
                    name="websocket_user_id"
                    invisible="backend != 'websocket'"
                    required="backend == 'websocket'"
                />
            </group>
        </field>
    </record>
</odoo>
