<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="after">
                <block title="Pingen" name="pingen_settings">
                    <setting
                        id="pingen_configuration_settings"
                        string="Pingen.com"
                        help="API credentials: Pingen app, user profile, API Access."
                    >
                        <div class="content-group">
                            <div class="row mt16">
                                <label
                                    for="pingen_clientid"
                                    class="col-lg-4 o_light_label"
                                />
                                <field name="pingen_clientid" />
                            </div>
                            <div class="row">
                                <label
                                    for="pingen_client_secretid"
                                    class="col-lg-4 o_light_label"
                                />
                                <field name="pingen_client_secretid" />
                            </div>
                            <div class="row">
                                <label
                                    for="pingen_organization"
                                    class="col-lg-4 o_light_label"
                                />
                                <field name="pingen_organization" />
                            </div>
                            <div class="row">
                                <label
                                    for="pingen_webhook_secret"
                                    class="col-lg-4 o_light_label"
                                />
                                <field name="pingen_webhook_secret" />
                            </div>
                            <div class="row">
                                <label
                                    for="pingen_staging"
                                    class="col-lg-4 o_light_label"
                                />
                                <field name="pingen_staging" />
                            </div>
                            <div class="row">
                                <label
                                    for="pingen_ssl_verify"
                                    class="col-lg-4 o_light_label"
                                />
                                <field name="pingen_ssl_verify" />
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
