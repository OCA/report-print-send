<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="printing_job_view_form" model="ir.ui.view">
        <field name="name">printing.job.form (in base_report_to_printer)</field>
        <field name="model">printing.job</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="job_state in ['completed']"
                    />
                    <field name="job_state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="time_at_creation" />
                            <field name="time_at_processing" />
                            <field name="time_at_completed" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="printing_job_view_tree" model="ir.ui.view">
        <field name="name">printing.job.tree (in base_report_to_printer)</field>
        <field name="model">printing.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="job_state" />
            </list>
        </field>
    </record>
</odoo>
