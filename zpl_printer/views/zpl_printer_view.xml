<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_zpl_printer_form" model="ir.ui.view">
        <field name="name">zpl_printer.zpl_printer.form</field>
        <field name="model">zpl_printer.zpl_printer</field>
        <field name="arch" type="xml">
            <form string="Label Printer">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="url" />
                            <field name="resolution" />
                            <field name="label_format" />
                            <field name="default" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_list_zpl_printer_list" model="ir.ui.view">
        <field name="name">view.zpl_printer.zpl_printer.list11</field>
        <field name="model">zpl_printer.zpl_printer</field>
        <field name="arch" type="xml">
            <list string="ZPL-Printer">
                <field name="name" />
                <field name="url" />
                <field name="resolution" />
                <field name="label_format" />
                <field name="default" />
            </list>
        </field>
    </record>

    <record id="action_zpl_printer" model="ir.actions.act_window">
        <field name="name">Label-Printers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">zpl_printer.zpl_printer</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="zpl_printer_res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block name="integration">
                <div class="o_setting_box col-12 col-lg-6 o_searchable_setting">
                    <button
                        name="%(zpl_printer.action_zpl_printer)d"
                        icon="fa-arrow-right"
                        type="action"
                        string="Label-Printers"
                        class="btn-link"
                    />
                </div>
            </block>
        </field>
    </record>
    <record id="view_users_form_simple_modif" model="ir.ui.view">
        <field name="name">res.users.preferences.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <group name="preferences" position="inside">
                <group name="printer_preference" string="Label-Printer-Preference">
                    <field name="printer_selection_strategy" />
                    <field name="zpl_printer_id" />
                    <field
                        name="zpl_printer_id"
                        widget="zpl_local_store_many2one"
                        string="Locally override Printer"
                        help="Choose a printer for this browser. If a printer is specified here, all labels will be printed on that printer."
                    />
                </group>
            </group>
        </field>
    </record>
    <record id="view_users_form" model="ir.ui.view">
        <field name="name">res.users.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']/group[1]">
                <group name="printer_preference" string="Label-Printer-Preference">
                    <field name="printer_selection_strategy" />
                    <field name="zpl_printer_id" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
