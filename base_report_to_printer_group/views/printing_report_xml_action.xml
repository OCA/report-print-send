<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="printing_report_xml_action_view_form">
        <field
            name="name"
        >printing.report.xml.action.form (in base_report_to_printer_group)</field>
        <field name="model">printing.report.xml.action</field>
        <field
            name="inherit_id"
            ref="base_report_to_printer.printing_report_xml_action_view_form"
        />
        <field name="arch" type="xml">
            <field name="user_id" position="attributes">
                <attribute
                    name="attrs"
                >{'required': [('group_id', '=', False)]}</attribute>
            </field>
            <field name="user_id" position="after">
                <field
                    name="group_id"
                    attrs="{'required': [('user_id', '=', False)]}"
                />
            </field>
        </field>
    </record>
    <record model="ir.ui.view" id="printing_report_xml_action_view_tree">
        <field
            name="name"
        >printing.report.xml.action.tree (in base_report_to_printer_group)</field>
        <field name="model">printing.report.xml.action</field>
        <field
            name="inherit_id"
            ref="base_report_to_printer.printing_report_xml_action_view_tree"
        />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="group_id" />
            </field>
        </field>
    </record>
</odoo>
