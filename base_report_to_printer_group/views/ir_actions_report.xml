<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="act_report_xml_view">
        <field
            name="name"
        >ir.actions.report.form (in base_report_to_printer_group)</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base_report_to_printer.act_report_xml_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='printing_action_ids']/list/field[@name='user_id']"
                position="attributes"
            >
                <attribute name="required">not group_id</attribute>
            </xpath>
            <xpath
                expr="//field[@name='printing_action_ids']/list/field[@name='user_id']"
                position="after"
            >
                <field name="group_id" required="not user_id" />
            </xpath>
        </field>
    </record>
</odoo>
