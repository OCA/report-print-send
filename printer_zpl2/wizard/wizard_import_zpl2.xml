<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_wizard_import_zpl2_form" model="ir.ui.view">
        <field name="name">wizard.import.zpl2.form</field>
        <field name="model">wizard.import.zpl2</field>
        <field name="arch" type="xml">
            <form string="Import ZPL2">
                <field name="state" invisible="1" />
                <group invisible="state != 'draft'">
                    <group>
                        <field name="label_id" invisible="1" />
                        <field name="zpl_file" filename="zpl_filename" />
                        <field name="zpl_filename" invisible="1" />
                    </group>
                    <group>
                        <field name="delete_component" />
                    </group>
                </group>
                <group string="Import report" invisible="state != 'done'">
                    <field name="report" nolabel="1" colspan="2" />
                </group>
                <footer>
                    <button
                        string="Import"
                        type="object"
                        name="import_zpl2"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        string="Cancel"
                        special="cancel"
                        invisible="state != 'draft'"
                    />
                    <button
                        string="Close"
                        special="cancel"
                        class="btn-primary"
                        invisible="state != 'done'"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
